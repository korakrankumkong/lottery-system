{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lottery_db;Username=postgres;Password=postgres;Pooling=true;Maximum Pool Size=128;SSL Mode=Disable"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 15,
    "PoolSize": 128
  },
  "Jwt": {
    "Issuer": "LotterySystem",
    "Audience": "LotterySystem.Client",
    "Key": "CHANGE_ME_TO_A_LONG_SECURE_SECRET_KEY"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
