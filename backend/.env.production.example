ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:10000
ConnectionStrings__DefaultConnection=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<password>;Pooling=true;Maximum Pool Size=128;SSL Mode=Require;Trust Server Certificate=true
Jwt__Issuer=LotterySystem
Jwt__Audience=LotterySystem.Client
Jwt__Key=CHANGE_ME_TO_A_LONG_SECURE_SECRET_KEY
Database__CommandTimeoutSeconds=30
Database__MaxRetryCount=5
Database__MaxRetryDelaySeconds=15
Database__PoolSize=128
Database__EnableDetailedErrors=false
Database__EnableSensitiveDataLogging=false
